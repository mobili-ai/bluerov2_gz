<?xml version="1.0"?>
<model>
  <name>sonoptix_echo</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Sonoptix ECHO multibeam imaging sonar (700 kHz mode: 120 x 20 deg, 256 beams,
    0.2-30 m). The gpu_lidar samples the acoustic fan geometry; the acoustic image is
    formed by the sonoptix_echo_sim ROS node.
  </description>
</model>
