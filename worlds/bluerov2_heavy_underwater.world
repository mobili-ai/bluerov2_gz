<?xml version="1.0"?>
<sdf version="1.6">
  <world name="bluerov2_heavy_underwater">

    <!-- Base Gazebo plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- IMU plugin manages all IMU sensors -->
    <plugin filename="libgz-sim-imu-system.so"
      name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Buoyancy plugin manages buoyancy for all models -->
    <plugin
      filename="gz-sim-buoyancy-system"
      name="gz::sim::systems::Buoyancy">
      <!-- Fluid density is 1 (air) above 0 and 1000 (water) below 0 -->
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0.0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <!-- Enable by model name -->
      <enable>bluerov2_heavy</enable>
    </plugin>


    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>


    <include>
      <uri>model://ground_plane</uri>
      <pose>0 0 0.1 3.14 0 0</pose>
    </include>



    <include>
      <uri>model://sand_heightmap</uri>
      <pose>0 7 -10 0 0 0</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>200</label>
      </plugin>
    </include>


    <include>
      <uri>model://bluerov2_heavy</uri>
      <pose>3 4 -0.5 0 0 1.57</pose>
    </include>




    <include>
      <uri>model://bluerov2_dummy</uri>
      <name>bluerov2_leader</name>
      <pose>6.0 0.0 -5 0 0 0</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>255</label>
      </plugin>
    </include>

    <!-- <include>
      <uri>model://bluerov2_dummy</uri>
      <name>bluerov2_leader2</name>
      <pose>4.0 -2.0 -3 0 0 0</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>255</label>
      </plugin>
    </include>

    <include>
      <uri>model://bluerov2_dummy</uri>
      <name>bluerov2_leader3</name>
      <pose>4.0 2.0 -3 0 0 0</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>255</label>
      </plugin>
    </include> -->



    <!-- Static wall: 20 m long (along y), 0.3 m thick, from the seabed (z=-10) to 0.5 m above the surface -->
    <model name="small_side_wall">
      <static>true</static>
      <pose>6.38 4.95 -2.28 1.57 0 0.6580</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>16 4 0.25</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>16 4 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>100</label>
      </plugin>
    </model>

    <!-- 21 m wall, perpendicular to small_side_wall at its far end (12.71, 9.84); outer corner flush -->
    <model name="long_side_wall">
      <static>true</static>
      <pose>6.266 17.975 -2.28 1.57 0 2.2288</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>21 4 0.25</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>21 4 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>100</label>
      </plugin>
    </model>

    <!-- 21 m wall, perpendicular to small_side_wall at its other end (0.05, 0.06), parallel to long_side_wall; outer corner flush -->
    <model name="long_side_wall_2">
      <static>true</static>
      <pose>-6.196 8.343 -2.28 1.57 0 2.2288</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>21 4 0.25</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>21 4 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>100</label>
      </plugin>
    </model>

    <!-- 16 m wall, parallel to small_side_wall, closing the far ends of long_side_wall and long_side_wall_2; outer corners flush -->
    <model name="small_side_wall_2">
      <static>true</static>
      <pose>-6.309 21.368 -2.28 1.57 0 0.6580</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>16 4 0.25</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>16 4 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>100</label>
      </plugin>
    </model>

    <include>
      <uri>model://axes</uri>
      <pose>0 0 0.2 0 0 0</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>150</label>
      </plugin>
    </include>

  </world>
</sdf>